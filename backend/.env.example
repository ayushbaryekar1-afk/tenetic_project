# Copy to backend/.env  (or put these in the project-root .env)
# Replace all placeholder values with real values before starting the backend in live mode.
DEMO_MODE=true

DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_AGENT_ENDPOINT=

# Optional
GENIE_AGENT_COUNT=6
REQUEST_TIMEOUT_SECONDS=90
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
